<!DOCTYPE html>
<html>
  <head>
    <title>{{title}}</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <!-- Bootstrap CSS (if you're using it) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body>
    {{> header}}

    <main class="container mt-4">
      <h1>Travel</h1>
      <p>Welcome to the Travel page. Browse our current getaways below.</p>

      <div class="row">
        {{#each trips}}
          <div class="col-md-4 mb-4">
            <div class="card h-100">
              <img src="/images/{{image}}" class="card-img-top" alt="{{name}}">
              <div class="card-body">
                <h5 class="card-title">{{name}}</h5>
                <p class="card-text">{{length}} | {{start}}</p>
                <p class="card-text">{{resort}}</p>
                <p class="card-text"><strong>${{perPerson}}</strong></p>
                <p class="card-text">{{description}}</p>
              </div>
            </div>
          </div>
        {{/each}}
      </div>
    </main>

    {{> footer}}
  </body>
</html>